rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['oskarchernysyot@gmail.com']; // ← ваш Gmail адміна
    }

    // Товари: бачать усі, змінює тільки адмін
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Заблоковані клієнти: пише тільки адмін; клієнт може побачити лише свій запис
    match /blocked/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Замовлення
    match /orders/{orderId} {
      // клієнт створює лише своє замовлення зі статусом "new"
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && !exists(/databases/$(database)/documents/blocked/$(request.auth.uid))
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[+0-9 ()-]{9,20}$')
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && request.resource.data.total is number && request.resource.data.total > 0
        && (!('paid' in request.resource.data) || request.resource.data.paid == false);
      // клієнт бачить свої, адмін — усі
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      // статус змінює тільки адмін
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
