rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['oskarchernysyot@gmail.com']; // ← ваш Gmail адміна
    }

    // Товари: бачать усі, змінює тільки адмін
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Замовлення
    match /orders/{orderId} {
      // клієнт створює лише своє замовлення зі статусом "new"
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new';
      // клієнт бачить свої, адмін — усі
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      // статус змінює тільки адмін
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
